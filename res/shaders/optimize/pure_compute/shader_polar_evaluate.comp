#version 450

#extension GL_KHR_shader_subgroup_arithmetic : require

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

const uint ZMAP_RESOLUTION = 7200;

struct BestResultData {
    float coreRadius;
    float slotAngle;
    float score;
    uint bestPoseIdx;
};

// 🌟 核心修改：统一改成一维数组，与 intersect 保持绝对一致
layout(std430, set = 0, binding = 1) readonly buffer ZMapBuffer { 
    uint zMap[]; 
};

layout(std430, set = 0, binding = 3) buffer OutputBuffer { BestResultData results[]; };

struct Particle {
    vec4 pos_vel;      // x: u0c, y: lambda, z: v_u0c, w: v_lambda
    vec4 pBest_data;   // x: pBest_u0c, y: pBest_lambda, z: pBest_score, w: padding
};

layout(std430, set = 0, binding = 5) buffer ParticleBuffer {
    Particle particles[];
};

layout(push_constant) uniform Push {
    layout(offset = 0) vec3 planeNormal;
    layout(offset = 16) vec3 planePoint;
    layout(offset = 32) vec3 planeU;
    layout(offset = 48) vec3 planeV;
    layout(offset = 64) float stepX;
    layout(offset = 68) float tanHelixAngle;
    layout(offset = 72) float radius;
    layout(offset = 76) uint stepsPerPose;
    layout(offset = 80) uint numTriangles;
    layout(offset = 84) uint curBatchSize;
} push;

shared float s_minR[16];
shared int   s_firstCut[16];
shared int   s_lastCut[16];

void main() {
    uint tid = gl_LocalInvocationID.x;
    
    uint poseIdx = gl_GlobalInvocationID.z;
    if(poseIdx >= push.curBatchSize) return;

    uint halfSize = zMap.length() / 2;
    float surfaceThreshold = push.radius - 0.02;

    float localMinR = 99999.;
    int localFirstCut = 99999;
    int localLastCut = -1;

    for (int i = int(tid); i < ZMAP_RESOLUTION; i += 256) {
        uint baseIdx = poseIdx * ZMAP_RESOLUTION + i;
        
        // 🌟 核心修改 3：分段读取！
        float rMin = uintBitsToFloat(zMap[baseIdx]);               // 从前半段读 minR
        float rMax = uintBitsToFloat(zMap[baseIdx + halfSize]);    // 跨越半个 Buffer 读 maxR

        // 计算芯厚
        if(rMin < push.radius) {
            localMinR = min(localMinR, rMin);
            if(rMax > push.radius)
                rMax = push.radius;
        }

        bool isSurfaceCut = (rMin < push.radius && rMax > surfaceThreshold);

        if(isSurfaceCut) {
            localFirstCut = min(localFirstCut, i);
            localLastCut = max(localLastCut, i);
        }
    }

    // --- subgroup内部规约 ---
    float sgMinR = subgroupMin(localMinR);
    int sgFirstCut = subgroupMin(localFirstCut);
    int sgLastCut = subgroupMax(localLastCut);

    if (gl_SubgroupInvocationID == 0) {
        s_minR[gl_SubgroupID] = sgMinR;
        s_firstCut[gl_SubgroupID] = sgFirstCut;
        s_lastCut[gl_SubgroupID] = sgLastCut;
    }

    barrier();

    if (gl_SubgroupID == 0) {
        float finalMinR = 99999.0;
        int finalFirstCut = 99999;
        int finalLastCut = -1;

        // 读取墙上（共享内存）的成绩
        if (gl_SubgroupInvocationID < gl_NumSubgroups) {
            finalMinR = s_minR[gl_SubgroupInvocationID];
            finalFirstCut = s_firstCut[gl_SubgroupInvocationID];
            finalLastCut = s_lastCut[gl_SubgroupInvocationID];
        }

        // 终极硬件归约
        float totalMinR = subgroupMin(finalMinR);
        int totalFirstCut = subgroupMin(finalFirstCut);
        int totalLastCut = subgroupMax(finalLastCut);

        // 最终由真正的 Workgroup "老大"（0号线程）计算得分并写出
        if (gl_SubgroupInvocationID == 0) {
            float finalSlotAngle = 0.0;
            if (totalFirstCut <= totalLastCut && totalFirstCut != 99999) {
                finalSlotAngle = float(totalLastCut - totalFirstCut) / float(ZMAP_RESOLUTION) * 180.0;
            }

            if (totalMinR < push.radius) {
                results[poseIdx].slotAngle = finalSlotAngle;
                results[poseIdx].coreRadius = totalMinR;
                results[poseIdx].bestPoseIdx = poseIdx; 

                float coreRadius = totalMinR;
                float score = -999999.0;
                
                if (coreRadius <= push.radius) { 
                    float targetSlotAngle = 65.0;
                    float targetArcLength = push.radius * radians(targetSlotAngle); 
                    float targetCoreRadius = 3.0;

                    float resultArcLength = radians(finalSlotAngle) * push.radius; 
                    float slotAngleError = abs(resultArcLength - targetArcLength);
                    float coreRadiusError = abs(coreRadius - targetCoreRadius);

                    float weightSlot = 20.0;
                    float weightCore = 50.0;
                    
                    float penaltySlot = (slotAngleError * weightSlot) * (slotAngleError * weightSlot);
                    float penaltyCore = (coreRadiusError * weightCore) * (coreRadiusError * weightCore);
                    score = -(penaltySlot + penaltyCore);
                }
                
                results[poseIdx].score = score;

                float current_pBest_score = particles[poseIdx].pBest_data.z;
                if(score > current_pBest_score) {
                    vec2 current_pos = particles[poseIdx].pos_vel.xy;
                    particles[poseIdx].pBest_data = vec4(current_pos.x, current_pos.y, score, 0.);
                }

            } else {
                results[poseIdx].coreRadius = 999999.0; 
                results[poseIdx].slotAngle = 0.0;
                results[poseIdx].score = -999999.0;
                results[poseIdx].bestPoseIdx = poseIdx;
            }
        }
    }

}