#version 450
layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

const uint ZMAP_RESOLUTION = 7200;

struct ResultData {
    vec2 coreRadiusPoint; vec2 tipPoint; vec2 tangent; vec2 normal; vec2 point;
    uint coreRadiusSqBits; float rakeAngle; float slotAngle; float score;
};

// 🌟 核心修改：统一改成一维数组，与 intersect 保持绝对一致
layout(std430, set = 0, binding = 1) readonly buffer ZMapBuffer { 
    uint zMap[]; 
};

layout(std430, set = 0, binding = 3) buffer OutputBuffer { ResultData results[]; };

layout(push_constant) uniform Push {
    layout(offset = 0) vec3 planeNormal;
    layout(offset = 16) vec3 planePoint;
    layout(offset = 32) vec3 planeU;
    layout(offset = 48) vec3 planeV;
    layout(offset = 64) float stepX;
    layout(offset = 68) float tanHelixAngle;
    layout(offset = 72) float radius;
    layout(offset = 76) uint stepsPerPose;
    layout(offset = 80) uint numTriangles;
    layout(offset = 84) uint curBatchSize;
} push;

void main() {
    if (gl_LocalInvocationID.x != 0) return;
    
    uint poseIdx = gl_GlobalInvocationID.z;
    float globalMinR = 99999.;
    
    float surfaceThreshold = push.radius - 0.005;

    int firstCut = -1;
    int lastCut = -1;

    uint halfSize = zMap.length() / 2;

    for (int i = 0; i < ZMAP_RESOLUTION; i++) {
        uint baseIdx = poseIdx * ZMAP_RESOLUTION + i;
        
        // 🌟 核心修改 3：分段读取！
        float rMin = uintBitsToFloat(zMap[baseIdx]);               // 从前半段读 minR
        float rMax = uintBitsToFloat(zMap[baseIdx + halfSize]);    // 跨越半个 Buffer 读 maxR

        // 计算芯厚
        if(rMin < push.radius) {
            if(rMin < globalMinR) {
                globalMinR = rMin;
            }
        }

        if(rMin < push.radius && rMax > push.radius) {
            rMax = push.radius;
        }

        bool isSurfaceCut = (rMin < push.radius && rMax > surfaceThreshold);

        if(isSurfaceCut) {
            if (firstCut == -1)
                firstCut = i;
            lastCut = i;
        }
    }

    float finalSlotAngle = 0.0;

    if(firstCut != -1 && lastCut != -1) {
        // 整个ZMAP_RESOLUTION代表180度
        finalSlotAngle = float(lastCut - firstCut) / float(ZMAP_RESOLUTION) * 180.0;
    }

    if(globalMinR < push.radius) {
        results[poseIdx].slotAngle = finalSlotAngle;
        results[poseIdx].coreRadiusSqBits = floatBitsToUint(globalMinR * globalMinR);


        float coreRadius = globalMinR;
        float score = -999999.0;

        if (coreRadius <= 5.0) { // 对应你 C++ 里的剔除逻辑
            // 这些目标参数甚至可以通过 push_constant 传进来，这里先写死演示
            float targetSlotAngle = 65.0;
            float targetArcLength = 5.0 * radians(targetSlotAngle);
            float targetCoreRadius = 3.0;

            float resultArcLength = radians(finalSlotAngle) * 5.0;

            float slotAngleError = abs(resultArcLength - targetArcLength);
            float coreRadiusError = abs(coreRadius - targetCoreRadius);

            float weightSlot = 1.0;
            float weightCore = 1.0;

            score = -(slotAngleError * weightSlot + coreRadiusError * weightCore);
        }
        
        results[poseIdx].score = score;
    } else {
        results[poseIdx].coreRadiusSqBits = 0xFFFFFFFF;
        results[poseIdx].slotAngle = 0.0;
        results[poseIdx].score = -999999.0; // 无效位姿给极低分
    }

}